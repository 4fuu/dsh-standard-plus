#!/usr/bin/env bash
# Prepares a fresh Amp orb for dsh-standard-plus: the pnpm that package.json
# pins, then the workspace's dependencies. Idempotent: a warm run downloads
# nothing.
set -euo pipefail

cd "$(dirname "$0")/.."

step() { printf '\n== %s (%ss)\n' "$1" "$SECONDS"; }

BIN_DIR="$HOME/.local/bin"

# Installed with npm into ~/.local, not corepack: corepack's pnpm shim crashes
# on Node 26 (ERR_VM_DYNAMIC_IMPORT_CALLBACK_MISSING).
PNPM_VERSION="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
step "pnpm $PNPM_VERSION"
if [ "$("$BIN_DIR/pnpm" --version 2>/dev/null)" != "$PNPM_VERSION" ]; then
  npm install --global --prefix "$HOME/.local" --silent "pnpm@$PNPM_VERSION"
fi

step "pnpm install"
"$BIN_DIR/pnpm" install --frozen-lockfile

step "done"
